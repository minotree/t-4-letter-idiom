  "response": "{\n  \"id\": \"cheonjamun-140\",\n  \"decision\": \"uncertain\",\n  \"field_findings\": [\n    {\n      \"field\": \"hanja\",\n      \"original_value\": \"說感武丁\",\n      \"proposed_value\": null,\n      \"reason\": \"원문 한자 '說感武丁'은 src-seokbong-1583, src-gwangju-1575, src-wikisource-translation 등에서 동일하게 확인됨. 다만, src-shiji-eun에서는 '傅說'과 관련된 인물로 해석됨. 이는 '說感武丁'이 '傅說'의 별칭 또는 관련된 인물로 해석될 수 있음을 시사함.\",\n      \"source_ids\": [\"src-seokbong-1583\", \"src-gwangju-1575\", \"src-wikisource-translation\", \"src-shiji-eun\"]\n    },\n    {\n      \"field\": \"reading\",\n      \"original_value\": \"열감무정\",\n      \"proposed_value\": \"설감무정\",\n      \"reason\": \"src-wikisource-translation에서는 '설감무정'으로 독음되어 있으나, src-shiji-eun에서는 '傅說'에 해당하는 전통 고전음 '열감무정'이 사용됨. 이는 독음 선택에 있어 '열감무정'과 '설감무정' 간의 차이가 존재함.\",\n      \"source_ids\": [\"src-wikisource-translation\", \"src-shiji-eun\"]\n    },\n    {\n      \"field\": \"meaning\",\n      \"original_value\": \"담벼락을 쌓던 어진 현인 부열은 은나라 임금 무정의 꿈에 나타나 감동을 주었습니다.\",\n      \"proposed_value\": null,\n      \"reason\": \"src-wikisource-translation에서는 '기리계'와 관련된 인물로 해석되나, src-shiji-eun에서는 '傅說'에 해당하는 인물로 해석됨. 이는 의미 해석에 있어 '부열'과 '기리계'의 구분이 필요함.\",\n      \"source_ids\": [\"src-wikisource-translation\", \"src-shiji-eun\"]\n    }\n  ],\n  \"checked_scope\": \"한자, 독음, 의미에 대한 원문과 해설 비교\",\n  \"unresolved\": [\"독음 선택: 은나라 재상 부열(傅說) 인명 고사에 따른 전통 고전음 '열감무정' vs 일반 자음 '설감무정' 선택 결정 필요.\"]\n}",
