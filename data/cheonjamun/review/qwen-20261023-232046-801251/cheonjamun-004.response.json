  "response": "{\n  \"id\": \"cheonjamun-004\",\n  \"decision\": \"uncertain\",\n  \"field_findings\": [\n    {\n      \"field\": \"hanja\",\n      \"original_value\": \"辰宿列張\",\n      \"proposed_value\": null,\n      \"reason\": \"원문 한자 '辰宿列張'은 1583년과 1575년 목판본에서 동일하게 확인됨. 다만, '宿'의 독음에 대한 해석 차이가 존재함.\",\n      \"source_ids\": [\"src-seokbong-1583\", \"src-gwangju-1575\"]\n    },\n    {\n      \"field\": \"reading\",\n      \"original_value\": \"진수열장\",\n      \"proposed_value\": \"진숙열장\",\n      \"reason\": \"국립국어원 한자음 규범에 따르면 '宿'은 '수'로 발음되나, 일반 대중음에서는 '숙'으로 발음되는 경우가 있음. 이로 인해 독음에 대한 불확실성이 존재함.\",\n      \"source_ids\": [\"src-korean-std-dict\"]\n    },\n    {\n      \"field\": \"meaning\",\n      \"original_value\": \"밤하늘의 수많은 별자리가 넓게 벌여져 늘어서 있습니다.\",\n      \"proposed_value\": null,\n      \"reason\": \"위키문헌의 번역은 '해와 달이 차고 기울며 별은 자리를 잡아 늘어서 있다.'로, 원문의 의미와는 약간 차이가 있음. 이로 인해 의미 해석에 대한 불확실성이 존재함.\",\n      \"source_ids\": [\"src-wikisource-translation\"]\n    }\n  ],\n  \"checked_scope\": \"한자, 독음, 의미에 대한 원문과 근거 자료 비교\",\n  \"unresolved\": [\"독음 선택: 천문 별자리(28수) 전통 독음 '진수열장' vs 일반 대중음 '진숙열장' 서비스 방침 결정 필요.\"]\n}",
