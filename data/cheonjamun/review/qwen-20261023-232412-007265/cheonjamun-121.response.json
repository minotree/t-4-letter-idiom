  "response": "{\n  \"id\": \"cheonjamun-121\",\n  \"decision\": \"change\",\n  \"field_findings\": [\n    {\n      \"field\": \"hanja\",\n      \"original_value\": \"杜藁鍾隷\",\n      \"proposed_value\": \"杜稾鍾隸\",\n      \"reason\": \"석봉천자문 1583년 목판본 해서체 원문에서 '藁'이 '稾'로 표기된 것을 확인함. '藁'과 '稾'은 의미와 사용 문맥에서 차이가 있으므로 수정이 필요함.\",\n      \"source_ids\": [\"src-seokbong-1583\", \"src-wikisource-translation\"]\n    },\n    {\n      \"field\": \"reading\",\n      \"original_value\": \"두고종례\",\n      \"proposed_value\": \"두고종례\",\n      \"reason\": \"기존 독음 '두고종례'는 '杜稾鍾隸'에 해당하는 것으로, 수정된 한자에 따라 독음은 유지됨.\",\n      \"source_ids\": [\"src-wikisource-translation\"]\n    },\n    {\n      \"field\": \"meaning\",\n      \"original_value\": \"두도의 초서 초고와 종요의 뛰어난 예서 글씨 등 천하의 명필들이 소장되어 있습니다.\",\n      \"proposed_value\": \"두고(초서의 시초)와 종례(예서의 대표)의 글씨로, 천하의 명필들이 소장하고 있는 것입니다.\",\n      \"reason\": \"원문 '杜稾鍾隸'에 해당하는 의미로, '두고'는 초서의 시초를, '종례'는 예서의 대표를 의미함. 기존 해설은 '두도'와 '종요'로 오해되었으므로 수정이 필요함.\",\n      \"source_ids\": [\"src-wikisource-translation\"]\n    }\n  ],\n  \"checked_scope\": \"입력 행의 네 한자에 해당하는 뜻\",\n  \"unresolved\": []\n}",
