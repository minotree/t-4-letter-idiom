  "response": "{\n  \"id\": \"cheonjamun-066\",\n  \"decision\": \"uncertain\",\n  \"field_findings\": [\n    {\n      \"field\": \"hanja\",\n      \"original_value\": \"夙興溫淸\",\n      \"proposed_value\": null,\n      \"reason\": \"석봉본과 광주본 모두 '夙興溫淸'로 기록되어 있으나, '淸'과 '凊'의 차이로 인해 '溫淸'과 '溫凊'의 해석 차이가 존재함.\",\n      \"source_ids\": [\"src-seokbong-1583\", \"src-gwangju-1575\"]\n    },\n    {\n      \"field\": \"reading\",\n      \"original_value\": \"숙흥온정\",\n      \"proposed_value\": \"숙흥온청\",\n      \"reason\": \"위키문헌 해설에서 '凊'을 '서늘할 청'으로 해석하며, '淸'은 '맑을 청'으로 해석할 수 있어 '온정'과 '온청'의 독음 차이가 존재함.\",\n      \"source_ids\": [\"src-wikisource-translation\"]\n    },\n    {\n      \"field\": \"meaning\",\n      \"original_value\": \"아침 일찍 일어나 부모님 안부를 살피고 겨울에는 따뜻하게 여름에는 시원하게 해 드립니다.\",\n      \"proposed_value\": null,\n      \"reason\": \"해설에서 '깊은 곳을 만나도 살얼음 지나듯 조심하고 일찍 일어나 덥고 차가운지 살피는 것'으로 해석되어, 원문의 의미 해석에 차이가 있음.\",\n      \"source_ids\": [\"src-wikisource-translation\"]\n    }\n  ],\n  \"checked_scope\": \"夙興溫淸의 한자, 독음, 의미에 대한 비교 검토\",\n  \"unresolved\": [\"독음 및 판본: 목판본 한자는 溫淸(맑을 청)이나 문맥상 凊(서늘할 청)의 통용자로 '숙흥온청' 또는 '숙흥온정' 이견 존재.\"]\n}",
