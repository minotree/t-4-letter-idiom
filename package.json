{
  "name": "four-letter-idiom",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.34.7",
  "engines": { "node": "24.x", "pnpm": ">=10 <11" },
  "scripts": {
    "test": "node --test packages/shared/test/*.test.mjs",
    "dev": "pnpm --filter @idioms/web dev",
    "build": "pnpm --filter @idioms/web build",
    "build:vercel": "pnpm --filter @idioms/web build --mode vercel",
    "typecheck": "pnpm -r --if-present typecheck",
    "preview": "pnpm --filter @idioms/web preview"
  }
}
